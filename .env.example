# ==============================================================
# IRIS — Intelligent Responsive Interactive System
# Environment Configuration
# ==============================================================

# Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (Ultra-fast flash-lite models for instantaneous replies)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
IRIS_AI_TEMPERATURE=0.5
IRIS_MAX_TOKENS=512

# Assistant Persona
IRIS_USER_NAME=Sir
IRIS_LOG_LEVEL=INFO

# Speech Recognition (STT) Engine: "speech_recognition", "vosk", "faster_whisper"
IRIS_STT_ENGINE=speech_recognition
IRIS_ENERGY_THRESHOLD=700
IRIS_SILENCE_TIMEOUT=0.6
IRIS_PHRASE_LIMIT=7.0
IRIS_MIC_INDEX=-1

# Text-To-Speech (TTS) Voice
IRIS_TTS_ENGINE=edge_tts
IRIS_VOICE_HI=hi-IN-SwaraNeural
IRIS_VOICE_EN=en-IN-NeerjaNeural
IRIS_VOICE_US=en-US-JennyNeural
IRIS_TTS_RATE=+15%
IRIS_TTS_PITCH=+0Hz

# UI Floating Orb Configuration
IRIS_ORB_SIZE=130
IRIS_ORB_OPACITY=0.95
IRIS_ORB_THEME=cyber_cyan

# Security & Safety Guard
IRIS_REQUIRE_CONFIRMATION=true
